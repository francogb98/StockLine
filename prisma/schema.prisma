generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id             String        @id @default(uuid())
  name           String
  address        String
  phone          String
  config         Json?
  createdAt      DateTime      @default(now())

  suspendedAt        DateTime? @map("suspended_at")
  suspendedReason    String?   @map("suspended_reason")
  suspendedByUserId  String?   @map("suspended_by_user_id")
  internalNotes      String?   @map("internal_notes")

  users              User[]
  categories         Category[]
  products           Product[]
  sales              Sale[]
  cashSessions       CashSession[]
  stockMovements     StockMovement[]
  subscription       Subscription?
  suspendedSales     SuspendedSale[]
  devoluciones       Devolucion[]
  couponRedemptions  CouponRedemption[]
  errors             AppError[]

  @@map("stores")
}

model Subscription {
  id                       String    @id @default(uuid())
  storeId                  String    @unique
  store                    Store     @relation(fields: [storeId], references: [id])
  status                   String
  plan                     String
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  trialEndsAt              DateTime?
  mercadoPagoPreapprovalId String?
  cancelledByAdmin         Boolean   @default(false) @map("cancelled_by_admin")
  cancelledByAdminUserId   String?   @map("cancelled_by_admin_user_id")
  adminNotes               String?   @map("admin_notes")
  previousStatus           String?   @map("previous_status")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  couponRedemptions  CouponRedemption[]

  @@map("subscriptions")
}

model User {
  id                     String   @id @default(uuid())
  storeId                String
  store                  Store    @relation(fields: [storeId], references: [id])
  email                  String   @unique
  name                   String
  role                   String
  isSuperAdmin           Boolean  @default(false) @map("is_super_admin")
  superAdminScope        String?  @map("super_admin_scope")
  passwordHash           String   @db.VarChar(255)
  hasCompletedOnboarding Boolean  @default(false)
  onboardingStep         Int      @default(0)
  draftOnboardingState   Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sales                    Sale[]
  cashSessions             CashSession[]
  stockMovements           StockMovement[]
  sessions                 Session[]
  suspendedSales           SuspendedSale[]
  devoluciones             Devolucion[]
  productions              Production[]
  ingredientStockMovements IngredientStockMovement[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id             String  @id @default(uuid())
  storeId        String
  store          Store   @relation(fields: [storeId], references: [id])
  name           String
  normalizedName String  @default("")
  description    String?

  products         Product[]
  globalProducts   GlobalProduct[]

  @@unique([storeId, normalizedName])
  @@map("categories")
}

model GlobalProduct {
  id                 String    @id @default(uuid())
  name               String
  brand              String?
  barcode            String?   @unique
  presentation       String?
  unit               String?
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  imageUrl           String?
  cloudinaryPublicId String?
  normalizedKey      String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products Product[]

  @@index([barcode])
  @@index([normalizedKey])
  @@map("global_products")
}

enum ProductStatus {
  ACTIVE
  MERGED
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  barcode     String?
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  globalProductId     String?
  globalProduct       GlobalProduct? @relation(fields: [globalProductId], references: [id])
  price               Decimal       @db.Decimal(12, 2)
  cost                Decimal       @db.Decimal(12, 2)
  stock               Decimal       @db.Decimal(12, 3)
  minStock            Decimal       @db.Decimal(12, 3)
  quantityType        QuantityType  @default(DISCRETA)
  unit                String        @default("unit")
  imageUrl            String?
  cloudinaryPublicId  String?
  status              ProductStatus @default(ACTIVE)
  mergedIntoId        String?
  mergedInto          Product?      @relation("ProductMerge", fields: [mergedIntoId], references: [id])
  mergedChildren      Product[]     @relation("ProductMerge")
  mergedAt            DateTime?
  mergedByUserId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  saleItems        SaleItem[]
  stockMovements   StockMovement[]
  devoluciones     DevolucionDetalle[]
  recipe           Recipe?
  presentations    ProductPresentation[]

  @@index([storeId, barcode])
  @@index([storeId, status])
  @@index([globalProductId])
  @@index([mergedIntoId])
  @@map("products")
}

enum QuantityType {
  DISCRETA
  CONTINUA
}

model ProductPresentation {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  quantity   Decimal  @db.Decimal(12, 3)
  unit       String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  saleItems SaleItem[]

  @@index([productId, active])
  @@map("product_presentations")
}

model Sale {
  id            String       @id @default(uuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  subtotal      Decimal      @db.Decimal(12, 2)
  tax           Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  paymentMethod String
  status        String       @default("completed")
  createdAt     DateTime     @default(now())

  items        SaleItem[]
  devoluciones Devolucion[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([cashSessionId])
  @@map("sales")
}

model CashSession {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  openingAmount  Decimal   @db.Decimal(12, 2) @default(0)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  closingAmount  Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  notes          String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  sales Sale[]

  @@index([storeId, closedAt])
  @@index([storeId, createdAt])
  @@map("cash_sessions")
}

model SaleItem {
  id                String              @id @default(uuid())
  saleId            String
  sale              Sale                @relation(fields: [saleId], references: [id])
  productId         String
  product           Product             @relation(fields: [productId], references: [id])
  productName       String
  quantity          Decimal             @db.Decimal(12, 3)
  unitPrice         Decimal             @db.Decimal(12, 2)
  total             Decimal             @db.Decimal(12, 2)
  presentationId    String?
  presentation      ProductPresentation? @relation(fields: [presentationId], references: [id])
  presentationName  String?
  baseQuantity      Decimal             @db.Decimal(12, 3) @default(0)

  devoluciones DevolucionDetalle[]

  @@index([saleId])
  @@index([presentationId])
  @@map("sale_items")
}

enum MovementType {
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  PRODUCT_CREATION
  IMPORT
  STOCK_CORRECTION
  CANCELLATION
  OWNER_WITHDRAWAL
  CUSTOMER_RETURN
  MERGE_IN
  MERGE_OUT
}

model StockMovement {
  id            String       @id @default(uuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  previousStock Decimal      @db.Decimal(12, 3)
  newStock      Decimal      @db.Decimal(12, 3)
  referenceId   String?
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@map("stock_movements")
}

model SuspendedSale {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Decimal  @db.Decimal(12, 2)
  itemCount Int
  createdAt DateTime @default(now())

  items SuspendedSaleItem[]

  @@index([storeId, createdAt(sort: Desc)])
  @@map("suspended_sales")
}

model SuspendedSaleItem {
  id              String        @id @default(uuid())
  suspendedSaleId String
  suspendedSale   SuspendedSale @relation(fields: [suspendedSaleId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)

  @@index([suspendedSaleId])
  @@map("suspended_sale_items")
}

enum DevolucionDisposicion {
  REINGRESAR_STOCK
  MERMAR
}

model Devolucion {
  id                String           @id @default(uuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  ventaId           String
  venta             Sale             @relation(fields: [ventaId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  fecha             DateTime         @default(now())
  motivo            String?
  observaciones     String?
  montoTotalDevuelto Decimal         @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  detalles DevolucionDetalle[]

  @@index([storeId, fecha(sort: Desc)])
  @@index([storeId, ventaId])
  @@index([userId, fecha(sort: Desc)])
  @@map("devoluciones")
}

model DevolucionDetalle {
  id             String                @id @default(uuid())
  devolucionId   String
  devolucion     Devolucion            @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product               @relation(fields: [productId], references: [id])
  saleItemId     String
  saleItem       SaleItem              @relation(fields: [saleItemId], references: [id])
  cantidad       Int
  precioUnitario Decimal               @db.Decimal(12, 2)
  subtotal       Decimal               @db.Decimal(12, 2)
  disposicion    DevolucionDisposicion @default(REINGRESAR_STOCK)
  createdAt      DateTime              @default(now())

  @@index([devolucionId])
  @@index([productId])
  @@index([saleItemId])
  @@map("devolucion_detalles")
}

// ============================================================
// INGREDIENTS & RECIPES (Phase 6-8)
// ============================================================

model IngredientCategory {
  id          String  @id @default(uuid())
  storeId     String
  name        String
  description String?

  ingredients Ingredient[]

  @@unique([storeId, name])
  @@map("ingredient_categories")
}

model Ingredient {
  id          String              @id @default(uuid())
  storeId     String
  name        String
  description String?
  unit        String
  cost        Decimal             @db.Decimal(12, 2) @default(0)
  stock       Decimal             @db.Decimal(12, 2) @default(0)
  minStock    Decimal             @db.Decimal(12, 2) @default(0)
  categoryId  String?
  category    IngredientCategory? @relation(fields: [categoryId], references: [id])
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  recipeItems      RecipeIngredient[]
  stockMovements   IngredientStockMovement[]
  productionUsages ProductionUsage[]

  @@index([storeId, isActive])
  @@index([storeId, categoryId])
  @@map("ingredients")
}

model Recipe {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  description String?
  productId   String?  @unique
  product     Product? @relation(fields: [productId], references: [id])
  yield       Decimal  @db.Decimal(12, 2) @default(1)
  yieldUnit   String   @default("unit")
  prepTime    Int?
  cost        Decimal  @db.Decimal(12, 2) @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeIngredient[]
  productions Production[]

  @@index([storeId, isActive])
  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  unit         String
  sortOrder    Int        @default(0)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model Production {
  id          String           @id @default(uuid())
  storeId     String
  recipeId    String
  recipe      Recipe           @relation(fields: [recipeId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  quantity    Decimal          @db.Decimal(12, 2)
  status      ProductionStatus @default(PENDING)
  notes       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  usages ProductionUsage[]

  @@index([storeId, status])
  @@map("productions")
}

model ProductionUsage {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantityUsed Decimal    @db.Decimal(12, 2)
  costAtTime   Decimal    @db.Decimal(12, 2)

  @@map("production_usages")
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IngredientMovementType {
  PURCHASE
  PRODUCTION
  ADJUSTMENT
  WASTE
  RETURN
}

model IngredientStockMovement {
  id            String                 @id @default(uuid())
  storeId       String
  ingredientId  String
  ingredient    Ingredient             @relation(fields: [ingredientId], references: [id])
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  type          IngredientMovementType
  quantity      Decimal                @db.Decimal(12, 2)
  previousStock Decimal                @db.Decimal(12, 2)
  newStock      Decimal                @db.Decimal(12, 2)
  costPerUnit   Decimal?               @db.Decimal(12, 2)
  referenceId   String?
  reason        String?
  createdAt     DateTime               @default(now())

  @@index([ingredientId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("ingredient_stock_movements")
}

// ============================================================
// SUPER ADMIN (Phase 2: model only)
// ============================================================

enum CouponDiscountType {
  PERCENTAGE
  FIXED
  FREE_TRIAL
}

enum AuditActorType {
  SUPER_ADMIN
  STORE_USER
  SYSTEM
  WEBHOOK
}

enum AppErrorSource {
  API
  PRISMA
  MERCADO_PAGO
  WEBHOOK
  POS
  UNKNOWN
}

enum AppErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model PlatformConfig {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model Coupon {
  id              String              @id @default(uuid())
  code            String              @unique
  description     String?
  discountType    CouponDiscountType  @map("discount_type")
  discountValue   Decimal             @db.Decimal(12, 2) @map("discount_value")
  durationDays    Int                 @default(30) @map("duration_days")
  maxRedemptions  Int?                @map("max_redemptions")
  redeemedCount   Int                 @default(0) @map("redeemed_count")
  applicablePlans String[]           @map("applicable_plans")
  startsAt        DateTime            @default(now()) @map("starts_at")
  expiresAt       DateTime?           @map("expires_at")
  isActive        Boolean             @default(true) @map("is_active")
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id                String        @id @default(uuid())
  couponId          String        @map("coupon_id")
  coupon            Coupon        @relation(fields: [couponId], references: [id])
  storeId           String        @map("store_id")
  store             Store         @relation(fields: [storeId], references: [id])
  subscriptionId    String        @map("subscription_id")
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  redeemedByUserId  String?       @map("redeemed_by_user_id")
  redeemedAt        DateTime      @default(now()) @map("redeemed_at")
  discountApplied   Decimal       @db.Decimal(12, 2) @map("discount_applied")
  notes             String?

  @@unique([couponId, subscriptionId])
  @@index([couponId, redeemedAt])
  @@index([storeId])
  @@map("coupon_redemptions")
}

model AuditLog {
  id          String         @id @default(uuid())
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id")
  storeId     String?        @map("store_id")
  action      String
  targetType  String?        @map("target_type")
  targetId    String?        @map("target_id")
  metadata    Json?
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([storeId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AppError {
  id               String           @id @default(uuid())
  storeId          String?          @map("store_id")
  store            Store?           @relation(fields: [storeId], references: [id])
  source           AppErrorSource
  severity         AppErrorSeverity
  statusCode       Int?             @map("status_code")
  method           String?
  path             String?
  message          String
  stack            String?          @db.Text
  fingerprint      String
  occurrences      Int              @default(1)
  lastSeenAt       DateTime         @default(now()) @map("last_seen_at")
  firstSeenAt      DateTime         @default(now()) @map("first_seen_at")
  resolvedAt       DateTime?        @map("resolved_at")
  resolvedByUserId String?          @map("resolved_by_user_id")
  metadata         Json?

  @@index([fingerprint, lastSeenAt(sort: Desc)])
  @@index([storeId, lastSeenAt(sort: Desc)])
  @@index([source, severity, lastSeenAt(sort: Desc)])
  @@index([resolvedAt, severity])
  @@map("app_errors")
}
